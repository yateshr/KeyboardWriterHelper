<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Configuration/PersonalLearning.cs" Link="PersonalLearning.cs" />
    <Compile Include="../../src/Configuration/Personalization.cs" Link="Personalization.cs" />
    <Compile Include="../../src/Engine/Engine.cs" Link="Engine.cs" />
    <Compile Include="../../src/Engine/SubjectAgreement.cs" Link="SubjectAgreement.cs" />
    <Compile Include="../../src/Core/Data.cs" Link="Data.cs" />
    <Compile Include="../../src/Spelling/Ranker.cs" Link="Ranker.cs" />
    <Compile Include="../Personalization/Shims.cs" Link="Shims.cs" />
    <Compile Include="Program.cs" />
    <EmbeddedResource Include="../../data/*.txt">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Include="../grammar-cases.txt" CopyToOutputDirectory="PreserveNewest" TargetPath="grammar-cases.txt" />
    <None Include="../must-not-change.txt" CopyToOutputDirectory="PreserveNewest" TargetPath="must-not-change.txt" />
  </ItemGroup>
</Project>
